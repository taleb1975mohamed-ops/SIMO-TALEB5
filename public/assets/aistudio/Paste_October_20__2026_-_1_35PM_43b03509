    function switchWeek() {
        currentWeek = document.getElementById('weekSelector').value;
        document.getElementById('otherCost').value = weeksData[currentWeek].other;
        renderVegTable();
        renderMeatTable();
        calculateBudget();
    }

    function saveWeekData() {
        weeksData[currentWeek].other = parseFloat(document.getElementById('otherCost').value) || 0;
        calculateBudget();
    }

    function calculateBudget() {
        const salary = parseFloat(document.getElementById('salaryInput').value) || 0;

        let totalGas = 0;
        gasList.forEach(g => { totalGas += g.count * g.price; });

        let totalGroc = 0;
        grocList.forEach(gr => { totalGroc += gr.qty * gr.price; });

        let totalWeekly = 0;
        let currVegTotal = 0;
        let currMeatTotal = 0;

        for (let w = 1; w <= 4; w++) {
            let vegSum = 0;
            weeksData[w].vegList.forEach(v => { vegSum += v.qty * v.price; });

            let meatSum = 0;
            weeksData[w].meatList.forEach(m => { meatSum += m.qty * m.price; });

            totalWeekly += vegSum + meatSum + weeksData[w].other;

            if (w == currentWeek) {
                currVegTotal = vegSum;
                currMeatTotal = meatSum;
            }
        }

        const grandTotal = totalGas + totalGroc + totalWeekly;
        const net = salary - grandTotal;

        document.getElementById('currWeekVeg').innerText = Math.round(currVegTotal) + ' DH';
        document.getElementById('currWeekMeat').innerText = Math.round(currMeatTotal) + ' DH';
        document.getElementById('sumGroc').innerText = Math.round(totalGroc) + ' DH';
        document.getElementById('sumGas').innerText = Math.round(totalGas) + ' DH';
        document.getElementById('sumWeekly').innerText = Math.round(totalWeekly) + ' DH';
        document.getElementById('sumTotal').innerText = Math.round(grandTotal) + ' DH';

        const netEl = document.getElementById('netSalary');
        netEl.innerText = Math.round(net) + ' DH';

        if (net < 0) {
            netEl.className = 'val-num rem-negative';
        } else {
            netEl.className = 'val-num rem-positive';
        }
    }

    function generateFullSummaryDetails() {
        const container = document.getElementById('summaryDetailsContainer');
        container.innerHTML = '';

        let grocHtml = `<div class="summary-box-detail">
            <h3><span>🛒 قسم الهري ومواد التموين</span></h3>
            <ul class="summary-item-list">`;
        let totalGroc = 0;
        grocList.forEach(item => {
            const sum = item.qty * item.price;
            totalGroc += sum;
            grocHtml += `<li><span>${item.name} (<span class="latin-num">${item.qty} × ${item.price} DH</span>)</span><b class="latin-num">${sum} DH</b></li>`;
        });
        grocHtml += `</ul><div class="summary-subtotal-badge">مجموع الهري: <span class="latin-num">${totalGroc} DH</span></div></div>`;
        container.innerHTML += grocHtml;

        let gasHtml = `<div class="summary-box-detail">
            <h3><span>🔥 قسم البوطة</span></h3>
            <ul class="summary-item-list">`;
        let totalGas = 0;
        gasList.forEach(item => {
            const sum = item.count * item.price;
            totalGas += sum;
            gasHtml += `<li><span>${item.name} (<span class="latin-num">${item.count} عدد × ${item.price} DH</span>)</span><b class="latin-num">${sum} DH</b></li>`;
        });
        gasHtml += `</ul><div class="summary-subtotal-badge">مجموع البوطة: <span class="latin-num">${totalGas} DH</span></div></div>`;
        container.innerHTML += gasHtml;

        let totalAllWeeks = 0;
        for (let w = 1; w <= 4; w++) {
            const wData = weeksData[w];
            let weekVegSum = 0;
            let weekMeatSum = 0;

            let weekHtml = `<div class="summary-box-detail">
                <h3><span>📅 الأسبوع <span class="latin-num">${w}</span></span></h3>
                <strong style="font-size:0.85rem; color:#16a085;">الخضار:</strong>
                <ul class="summary-item-list">`;

            wData.vegList.forEach(v => {
                const s = v.qty * v.price;
                weekVegSum += s;
                weekHtml += `<li><span>${v.name} (<span class="latin-num">${v.qty} kg × ${v.price} DH</span>)</span><b class="latin-num">${s} DH</b></li>`;
            });

            weekHtml += `</ul><strong style="font-size:0.85rem; color:#16a085;">اللحوم والأسماك:</strong>
                <ul class="summary-item-list">`;

            wData.meatList.forEach(m => {
                const s = m.qty * m.price;
                weekMeatSum += s;
                weekHtml += `<li><span>${m.name} (<span class="latin-num">${m.qty} kg × ${m.price} DH</span>)</span><b class="latin-num">${s} DH</b></li>`;
            });

            weekHtml += `</ul>
                <div style="display:flex; justify-content:space-between; font-size:0.85rem; margin-bottom:8px;">
                    <span>مصاريف طارئة أسبوعية:</span><b class="latin-num">${wData.other} DH</b>
                </div>`;

            const weekTotal = weekVegSum + weekMeatSum + wData.other;
            totalAllWeeks += weekTotal;

            weekHtml += `<div class="summary-subtotal-badge">إجمالي الأسبوع ${w}: <span class="latin-num">${weekTotal} DH</span></div></div>`;
            container.innerHTML += weekHtml;
        }
    }

    loadSavedData();
    renderVegTable();
    renderMeatTable();
    renderGrocTable();
    renderGasTable();
    calculateBudget();
